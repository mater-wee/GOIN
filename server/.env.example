# Copy to .env and edit. Every setting is optional.

# Port for the API. The web app's dev server proxies /api here.
# PORT=8787

# Defaults to goin_contract_id in contracts/deployments/testnet.json.
# GOIN_CONTRACT_ID=C...

# Where the database and evidence files are stored. Defaults to server/data.
# DATA_DIR=./data

# --- Optional AI extraction (step 6) ---
# Without these, receipts are read with OCR plus built-in rules (no AI, no cost).
# Any OpenAI-compatible chat completions API works. Only the OCR text is sent,
# never the image. Use a provider whose data terms fit your users' privacy.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=a-model-name-from-your-provider

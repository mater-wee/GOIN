{
  "name": "goin-server",
  "private": true,
  "version": "0.1.0",
  "description": "GOIN backend: off-chain ticket details, purchase evidence, wallet sign-in, and AI-assisted receipt reading",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:sep53": "node scripts/test-sep53.ts",
    "test:api": "node scripts/test-api.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
